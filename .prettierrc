{
    "$schema": "https://json.schemastore.org/prettierrc",
    "plugins": ["prettier-plugin-tailwindcss"],
    "semi": false,
    "printWidth": 160,
    "singleQuote": true,
    "arrowParens": "always",
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "vueIndentScriptAndStyle": true,
    "singleAttributePerLine": false,
    "quoteProps": "consistent"
}